# DeepSeek — default open-source path (text-based PDFs via local Markdown).
# Get a key at https://platform.deepseek.com/ or point a compatible proxy here.
DEEPSEEK_API_KEY=sk-...

# Anthropic — optional. Needed for Claude vision models (scanned PDFs / images).
# ANTHROPIC_API_KEY=sk-ant-...

# Optional bundled keys for other BYOK providers (SPA can also send a per-request key).
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
# MISTRAL_API_KEY=...

# Optional: port the Node API listens on (defaults to 8787).
API_PORT=8787
